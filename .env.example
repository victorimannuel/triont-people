FLASK_APP=app:create_app
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-secret

# Local SQLite fallback:
# DATABASE_URL=sqlite:///people_dev.db


# Local PostgreSQL dev example after running scripts/setup_local_postgres.sh:
# DATABASE_URL=postgresql+psycopg2://people_app:people_dev_password@localhost:5432/people_dev

# PostgreSQL production example:
DATABASE_URL=postgresql+psycopg2://people_app:change-me@postgres:5432/people

# Use migrations in production. Keep AUTO_CREATE_DB=true only for quick local demos.
AUTO_CREATE_DB=false
DB_POOL_RECYCLE=300
